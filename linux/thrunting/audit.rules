#
# Linux Audit Daemon - Best Practice Configuration
# /etc/audit/audit.rules
#
# Compiled by Florian Roth
# Modified by Samuel Brucker
# Enhanced with MITRE ATT&CK Framework technique IDs
#
# Created  : 2017/12/05
# Modified : 2026/03/14
#
# Based on rules published here:
#   Gov.uk auditd rules
#   	https://github.com/gds-operations/puppet-auditd/pull/1
# 	CentOS 7 hardening
# 		https://highon.coffee/blog/security-harden-centos-7/#auditd---audit-daemon
# 	Linux audit repo
# 		https://github.com/linux-audit/audit-userspace/tree/master/rules
# 	Auditd high performance linux auditing
# 		https://linux-audit.com/tuning-auditd-high-performance-linux-auditing/
#	MITRE ATT&CK auditd mapping
#		https://github.com/bfuzzy/auditd-attack
#
# Further rules
# 	For PCI DSS compliance see:
# 		https://github.com/linux-audit/audit-userspace/blob/master/rules/30-pci-dss-v31.rules
# 	For NISPOM compliance see:
# 		https://github.com/linux-audit/audit-userspace/blob/master/rules/30-nispom.rules

# Remove any existing rules
-D

# Buffer Size
## Feel free to increase this if the machine panic's
-b 8192

# Failure Mode
## Possible values: 0 (silent), 1 (printk, print a failure message), 2 (panic, halt the system)
-f 1

# Ignore errors
## e.g. caused by users or files not found in the local environment
-i

# Web Server Activity

## Find the UID of your web server user (e.g., 'id www-data', 'id apache')
## and replace '33' with the correct UID.
# Default: www-data:x:33:33
-a always,exit -F arch=b64 -S execve -F euid=33 -k detect_execve_www

# Self Auditing ---------------------------------------------------------------

## Audit the audit logs
### Successful and unsuccessful attempts to read information from the audit records
-w /var/log/audit/ -p wa -k auditlog
-w /var/audit/ -p wa -k auditlog

## Auditd configuration
### Modifications to audit configuration that occur while the audit collection functions are operating
-w /etc/audit/ -p wa -k auditconfig
-w /etc/libaudit.conf -p wa -k auditconfig
-w /etc/audisp/ -p wa -k audispconfig

## Monitor for use of audit management tools
-w /sbin/auditctl -p x -k audittools
-w /sbin/auditd -p x -k audittools
-w /usr/sbin/auditd -p x -k audittools
-w /usr/sbin/augenrules -p x -k audittools

## Access to all audit trails

-a always,exit -F path=/usr/sbin/ausearch -F perm=x -k audittools
-a always,exit -F path=/usr/sbin/aureport -F perm=x -k audittools
-a always,exit -F path=/usr/sbin/aulast -F perm=x -k audittools
-a always,exit -F path=/usr/sbin/aulastlogin -F perm=x -k audittools
-a always,exit -F path=/usr/sbin/auvirt -F perm=x -k audittools

# Filters ---------------------------------------------------------------------

### We put these early because audit is a first match wins system.

## Ignore current working directory records
-a always,exclude -F msgtype=CWD

## Ignore EOE records (End Of Event, not needed)
-a always,exclude -F msgtype=EOE

## Cron jobs fill the logs with stuff we normally don't want (works with SELinux)
-a never,user -F subj_type=crond_t
-a never,exit -F subj_type=crond_t

## This prevents chrony from overwhelming the logs
-a never,exit -F arch=b64 -S adjtimex -F auid=-1 -F uid=chrony -F subj_type=chronyd_t

## This is not very interesting and wastes a lot of space if the server is public facing
-a always,exclude -F msgtype=CRYPTO_KEY_USER

## Open VM Tools
-a exit,never -F arch=b64 -S all -F exe=/usr/bin/vmtoolsd

## VMWare tools
-a exit,never -F arch=b32 -S fork -F success=0 -F path=/usr/lib/vmware-tools -F subj_type=initrc_t -F exit=-2
-a exit,never -F arch=b64 -S fork -F success=0 -F path=/usr/lib/vmware-tools -F subj_type=initrc_t -F exit=-2

## High Volume Event Filter (especially on Linux Workstations)
-a never,exit -F arch=b32 -F dir=/dev/shm/ -F key=sharedmemaccess
-a never,exit -F arch=b64 -F dir=/dev/shm/ -F key=sharedmemaccess

-a never,exit -F arch=b32 -F dir=/var/lock/lvm/ -F key=locklvm
-a never,exit -F arch=b64 -F dir=/var/lock/lvm/ -F key=locklvm

## Filebeat
### https://www.elastic.co/guide/en/beats/filebeat/current/directory-layout.html

-a never,exit -F arch=b32 -F path=/opt/filebeat -F perm=wa -F key=filebeat
-a never,exit -F arch=b64 -F path=/opt/filebeat -F perm=wa -F key=filebeat

-a always,exit -F arch=b32 -F dir=/etc/filebeat/ -F perm=wa -F key=filebeat
-a always,exit -F arch=b64 -F dir=/etc/filebeat/ -F perm=wa -F key=filebeat

-a always,exit -F arch=b32 -F dir=/usr/share/filebeat/ -F perm=wa -F key=filebeat
-a always,exit -F arch=b64 -F dir=/usr/share/filebeat/ -F perm=wa -F key=filebeat

-a always,exit -F arch=b64 -F dir=/usr/share/filebeat/bin/ -F perm=x -F key=filebeat
-a always,exit -F arch=b32 -F dir=/usr/share/filebeat/bin/ -F perm=x -F key=filebeat

# Rules -----------------------------------------------------------------------

## Kernel parameters
-w /etc/sysctl.conf -p wa -k sysctl
-w /etc/sysctl.d -p wa -k sysctl

## Kernel module loading and unloading — T1547.006 Kernel Modules and Extensions
-a always,exit -F perm=x -F auid!=-1 -F path=/sbin/insmod -k T1547.006_Kernel_Modules
-a always,exit -F perm=x -F auid!=-1 -F path=/sbin/modprobe -k T1547.006_Kernel_Modules
-a always,exit -F perm=x -F auid!=-1 -F path=/sbin/rmmod -k T1547.006_Kernel_Modules
-a always,exit -F arch=b64 -S finit_module -S init_module -S delete_module -F auid!=-1 -k T1547.006_Kernel_Modules
-a always,exit -F arch=b32 -S finit_module -S init_module -S delete_module -F auid!=-1 -k T1547.006_Kernel_Modules

## Modprobe configuration
-w /etc/modprobe.conf -p wa -k T1547.006_Kernel_Modules
-w /etc/modprobe.d -p wa -k T1547.006_Kernel_Modules

## KExec usage (all actions)
-a always,exit -F arch=b64 -S kexec_load -k T1547.006_Kernel_Modules

## Special files
-a always,exit -F arch=b64 -S mknod -S mknodat -k specialfiles

## Mount operations — T1052 Exfiltration Over Physical Medium
## NOTE: auid>=1000 restricts to interactive users only; systemd/services use lower UIDs.
## In VM environments the broader auid!=-1 fires hundreds of times/hr on namespace mounts.
-a always,exit -F arch=b64 -S mount -S umount2 -F auid>=1000 -k T1052_Exfil_Physical_Medium
-a always,exit -F arch=b32 -S mount -F auid>=1000 -k T1052_Exfil_Physical_Medium

### NFS mount
-a always,exit -F path=/sbin/mount.nfs -F perm=x -F auid>=500 -F auid!=4294967295 -k T1078_Valid_Accounts
-a always,exit -F path=/usr/sbin/mount.nfs -F perm=x -F auid>=500 -F auid!=4294967295 -k T1078_Valid_Accounts

## Change swap (only attributable)
-a always,exit -F arch=b64 -S swapon -S swapoff -F auid!=-1 -k swap

## Time — T1070.006 Timestomp
-a always,exit -F arch=b64 -F uid!=ntp -S adjtimex -S settimeofday -S clock_settime -k T1070.006_Timestomp
-a always,exit -F arch=b32 -S adjtimex -S settimeofday -S clock_settime -k T1070.006_Timestomp
### Local time zone
-w /etc/localtime -p wa -k T1070.006_Timestomp

## System banner / MOTD — T1491.002 Defacement
-w /etc/motd -p wa -k T1491.002_Defacement
-w /etc/issue -p wa -k T1491.002_Defacement
-w /etc/issue.net -p wa -k T1491.002_Defacement

## Stunnel — T1573 Encrypted Channel
-w /usr/sbin/stunnel -p x -k T1573_Encrypted_Channel
-w /usr/bin/stunnel -p x -k T1573_Encrypted_Channel

## Cron configuration & scheduled jobs — T1053.003 Cron
-w /etc/cron.allow -p wa -k T1053.003_Cron
-w /etc/cron.deny -p wa -k T1053.003_Cron
-w /etc/cron.d/ -p wa -k T1053.003_Cron
-w /etc/cron.daily/ -p wa -k T1053.003_Cron
-w /etc/cron.hourly/ -p wa -k T1053.003_Cron
-w /etc/cron.monthly/ -p wa -k T1053.003_Cron
-w /etc/cron.weekly/ -p wa -k T1053.003_Cron
-w /etc/crontab -p wa -k T1053.003_Cron
-w /var/spool/cron/ -p wa -k T1053.003_Cron
-w /var/spool/cron/crontabs/ -p wa -k T1053.003_Cron

## At scheduling — T1053.002 At
-w /etc/at.allow -p wa -k T1053.002_At
-w /etc/at.deny -p wa -k T1053.002_At
-w /var/spool/at/ -p wa -k T1053.002_At
-w /etc/anacrontab -p wa -k T1053.003_Cron

## User, group, password databases — T1087 Account Discovery
-w /etc/group -p wa -k T1087_Account_Discovery
-w /etc/passwd -p wa -k T1087_Account_Discovery
-w /etc/gshadow -k T1087_Account_Discovery
-w /etc/shadow -k T1087_Account_Discovery
-w /etc/security/opasswd -k T1087_Account_Discovery
-w /usr/sbin/nologin -k T1087_Account_Discovery
-w /sbin/nologin -k T1087_Account_Discovery

## Sudoers file changes — T1548.003 Sudo and Sudo Caching
-w /etc/sudoers -p wa -k T1548.003_Sudo
-w /etc/sudoers.d/ -p wa -k T1548.003_Sudo

## Passwd — T1098 Account Manipulation
-w /usr/bin/passwd -p x -k T1098_Account_Manipulation

## Tools to change group identifiers — T1098 Account Manipulation
-w /usr/sbin/groupadd -p x -k T1098_Account_Manipulation
-w /usr/sbin/groupmod -p x -k T1098_Account_Manipulation
-w /usr/sbin/addgroup -p x -k T1098_Account_Manipulation
-w /usr/sbin/useradd -p x -k T1098_Account_Manipulation
-w /usr/sbin/userdel -p x -k T1098_Account_Manipulation
-w /usr/sbin/usermod -p x -k T1098_Account_Manipulation
-w /usr/sbin/adduser -p x -k T1098_Account_Manipulation

## Privileged command execution — T1078 Valid Accounts
-a always,exit -F path=/usr/sbin/userdel -F perm=x -F auid>=500 -F auid!=4294967295 -k T1078_Valid_Accounts
-a always,exit -F path=/bin/su -F perm=x -F auid>=500 -F auid!=4294967295 -k T1078_Valid_Accounts
-a always,exit -F path=/bin/mount -F perm=x -F auid>=500 -F auid!=4294967295 -k T1078_Valid_Accounts
-a always,exit -F path=/bin/umount -F perm=x -F auid>=500 -F auid!=4294967295 -k T1078_Valid_Accounts
-a always,exit -F path=/bin/chgrp -F perm=x -F auid>=500 -F auid!=4294967295 -k T1078_Valid_Accounts
-a always,exit -F path=/sbin/pam_timestamp_check -F perm=x -F auid>=500 -F auid!=4294967295 -k T1078_Valid_Accounts
-a always,exit -F path=/sbin/unix_chkpwd -F perm=x -F auid>=500 -F auid!=4294967295 -k T1078_Valid_Accounts
-a always,exit -F path=/sbin/pwck -F perm=x -F auid>=500 -F auid!=4294967295 -k T1078_Valid_Accounts
-a always,exit -F path=/usr/sbin/suexec -F perm=x -F auid>=500 -F auid!=4294967295 -k T1078_Valid_Accounts
-a always,exit -F path=/usr/sbin/usermod -F perm=x -F auid>=500 -F auid!=4294967295 -k T1078_Valid_Accounts
-a always,exit -F path=/usr/sbin/newusers -F perm=x -F auid>=500 -F auid!=4294967295 -k T1078_Valid_Accounts
-a always,exit -F path=/usr/sbin/groupdel -F perm=x -F auid>=500 -F auid!=4294967295 -k T1078_Valid_Accounts
-a always,exit -F path=/usr/bin/gpasswd -F perm=x -F auid>=500 -F auid!=4294967295 -k T1078_Valid_Accounts
-a always,exit -F path=/usr/bin/crontab -F perm=x -F auid>=500 -F auid!=4294967295 -k T1078_Valid_Accounts
-a always,exit -F path=/usr/bin/sudo -F perm=x -F auid>=500 -F auid!=4294967295 -k T1078_Valid_Accounts
-a always,exit -F path=/usr/bin/chsh -F perm=x -F auid>=500 -F auid!=4294967295 -k T1078_Valid_Accounts
-a always,exit -F path=/usr/bin/chfn -F perm=x -F auid>=500 -F auid!=4294967295 -k T1078_Valid_Accounts
-a always,exit -F path=/usr/bin/chage -F perm=x -F auid>=500 -F auid!=4294967295 -k T1078_Valid_Accounts
-a always,exit -F path=/usr/bin/setfacl -F perm=x -F auid>=500 -F auid!=4294967295 -k T1078_Valid_Accounts
-a always,exit -F path=/usr/bin/newgrp -F perm=x -F auid>=500 -F auid!=4294967295 -k T1078_Valid_Accounts
-a always,exit -F path=/usr/bin/at -F perm=x -F auid>=500 -F auid!=4294967295 -k T1078_Valid_Accounts

## Login configuration and information — T1078 Valid Accounts
-w /etc/login.defs -p wa -k T1078_Valid_Accounts
-w /etc/securetty -p wa -k T1078_Valid_Accounts
-w /var/log/faillog -p wa -k T1078_Valid_Accounts
-w /var/log/lastlog -p wa -k T1078_Valid_Accounts
-w /var/log/tallylog -p wa -k T1078_Valid_Accounts

## Network Environment — T1016 System Network Configuration Discovery
### Changes to hostname
-a always,exit -F arch=b64 -S sethostname -S setdomainname -k T1016_System_Network_Config_Discovery

### Detect Remote Shell Use — T1059.004 Unix Shell
-a always,exit -F arch=b64 -F exe=/bin/bash -F success=1 -S connect -k T1059.004_Unix_Shell
-a always,exit -F arch=b64 -F exe=/usr/bin/bash -F success=1 -S connect -k T1059.004_Unix_Shell

### Successful IPv4 Connections — T1071 Application Layer Protocol
-a always,exit -F arch=b64 -S connect -F a2=16 -F success=1 -F key=T1071_App_Layer_Protocol_IPv4

### Successful IPv6 Connections
-a always,exit -F arch=b64 -S connect -F a2=28 -F success=1 -F key=T1071_App_Layer_Protocol_IPv6

### C2 connections — T1071 (32-bit outbound)
-a always,exit -F arch=b32 -S socketcall -F a0=3 -k T1071_App_Layer_Protocol_32bit

### Changes to other files
-w /etc/hosts -p wa -k T1016_System_Network_Config_Discovery
-w /etc/sysconfig/network -p wa -k T1016_System_Network_Config_Discovery
-w /etc/sysconfig/network-scripts -p w -k T1016_System_Network_Config_Discovery
-w /etc/network/ -p wa -k T1016_System_Network_Config_Discovery
-a always,exit -F dir=/etc/NetworkManager/ -F perm=wa -k T1016_System_Network_Config_Discovery
-w /etc/resolv.conf -k T1016_System_Network_Config_Discovery
-w /etc/hosts.allow -k T1016_System_Network_Config_Discovery
-w /etc/hosts.deny -k T1016_System_Network_Config_Discovery

### Changes to issue
-w /etc/issue -p wa -k T1082_System_Information_Discovery
-w /etc/issue.net -p wa -k T1082_System_Information_Discovery

## System startup scripts — T1037 Boot or Logon Initialization Scripts
-w /etc/inittab -p wa -k T1037_Boot_Initialization_Scripts
-w /etc/init.d/ -p wa -k T1037_Boot_Initialization_Scripts
-w /etc/init/ -p wa -k T1037_Boot_Initialization_Scripts

## Library search paths — T1574.006 Dynamic Linker Hijacking
-w /etc/ld.so.conf -p wa -k T1574.006_Dynamic_Linker_Hijacking
-w /etc/ld.so.conf.d -p wa -k T1574.006_Dynamic_Linker_Hijacking

## Systemwide library preloads (LD_PRELOAD) — T1574.006 Dynamic Linker Hijacking
-w /etc/ld.so.preload -p wa -k T1574.006_Dynamic_Linker_Hijacking

## Pam configuration — T1556.003 Pluggable Authentication Modules
-w /etc/pam.d/ -p wa -k T1556.003_Pluggable_Auth_Modules
-w /etc/security/limits.conf -p wa  -k T1556.003_Pluggable_Auth_Modules
-w /etc/security/limits.d -p wa  -k T1556.003_Pluggable_Auth_Modules
-w /etc/security/pam_env.conf -p wa -k T1556.003_Pluggable_Auth_Modules
-w /etc/security/namespace.conf -p wa -k T1556.003_Pluggable_Auth_Modules
-w /etc/security/namespace.d -p wa -k T1556.003_Pluggable_Auth_Modules
-w /etc/security/namespace.init -p wa -k T1556.003_Pluggable_Auth_Modules
-w /etc/pam.d/common-password -p wa -k T1201_Password_Policy_Discovery

## Mail configuration
-w /etc/aliases -p wa -k mail
-w /etc/postfix/ -p wa -k mail
-w /etc/exim4/ -p wa -k mail

## SSH configuration — T1021.004 Remote Services: SSH
-w /etc/ssh/sshd_config -k T1021.004_SSH
-w /etc/ssh/sshd_config.d -k T1021.004_SSH

## root ssh key tampering — T1098.004 SSH Authorized Keys
-w /root/.ssh -p wa -k T1098.004_SSH_Authorized_Keys

# Systemd — T1543.002 Create or Modify System Process: Systemd Service
-w /bin/systemctl -p x -k T1543.002_Systemd_Service
-w /etc/systemd/ -p wa -k T1543.002_Systemd_Service
-w /usr/lib/systemd -p wa -k T1543.002_Systemd_Service

## https://systemd.network/systemd.generator.html
-w /etc/systemd/system-generators/ -p wa -k T1543.002_Systemd_Generator
-w /usr/local/lib/systemd/system-generators/ -p wa -k T1543.002_Systemd_Generator
-w /usr/lib/systemd/system-generators -p wa -k T1543.002_Systemd_Generator

-w /etc/systemd/user-generators/ -p wa -k T1543.002_Systemd_Generator
-w /usr/local/lib/systemd/user-generators/ -p wa -k T1543.002_Systemd_Generator
-w /lib/systemd/system-generators/ -p wa -k T1543.002_Systemd_Generator

## SELinux events that modify the system's Mandatory Access Controls (MAC)
-w /etc/selinux/ -p wa -k T1562.001_Disable_Modify_Tools

## Critical elements access failures
-a always,exit -F arch=b64 -S open -F dir=/etc -F success=0 -k unauthedfileaccess
-a always,exit -F arch=b64 -S open -F dir=/bin -F success=0 -k unauthedfileaccess
-a always,exit -F arch=b64 -S open -F dir=/sbin -F success=0 -k unauthedfileaccess
-a always,exit -F arch=b64 -S open -F dir=/usr/bin -F success=0 -k unauthedfileaccess
-a always,exit -F arch=b64 -S open -F dir=/usr/sbin -F success=0 -k unauthedfileaccess
-a always,exit -F arch=b64 -S open -F dir=/var -F success=0 -k unauthedfileaccess
-a always,exit -F arch=b64 -S open -F dir=/home -F success=0 -k unauthedfileaccess
-a always,exit -F arch=b64 -S open -F dir=/srv -F success=0 -k unauthedfileaccess

## Process ID change (switching accounts) — T1548 Abuse Elevation Control Mechanism
-w /bin/su -p x -k T1548_Abuse_Elevation_Control
-w /usr/bin/sudo -p x -k T1548_Abuse_Elevation_Control

## Power state — T1529 System Shutdown/Reboot
-w /sbin/shutdown -p x -k T1529_System_Shutdown_Reboot
-w /sbin/poweroff -p x -k T1529_System_Shutdown_Reboot
-w /sbin/reboot -p x -k T1529_System_Shutdown_Reboot
-w /sbin/halt -p x -k T1529_System_Shutdown_Reboot

## Session initiation information — T1108 Redundant Access
-w /var/run/utmp -p wa -k T1108_Redundant_Access
-w /var/log/btmp -p wa -k T1108_Redundant_Access
-w /var/log/wtmp -p wa -k T1108_Redundant_Access

## Discretionary Access Control (DAC) modifications — T1222 File and Directory Permissions Modification
-a always,exit -F arch=b64 -S chmod  -F auid>=1000 -F auid!=-1 -k T1222_File_Directory_Permissions_Mod
-a always,exit -F arch=b64 -S chown -F auid>=1000 -F auid!=-1 -k T1222_File_Directory_Permissions_Mod
-a always,exit -F arch=b64 -S fchmod -F auid>=1000 -F auid!=-1 -k T1222_File_Directory_Permissions_Mod
-a always,exit -F arch=b64 -S fchmodat -F auid>=1000 -F auid!=-1 -k T1222_File_Directory_Permissions_Mod
-a always,exit -F arch=b64 -S fchown -F auid>=1000 -F auid!=-1 -k T1222_File_Directory_Permissions_Mod
-a always,exit -F arch=b64 -S fchownat -F auid>=1000 -F auid!=-1 -k T1222_File_Directory_Permissions_Mod
-a always,exit -F arch=b64 -S fremovexattr -F auid>=1000 -F auid!=-1 -k T1222_File_Directory_Permissions_Mod
-a always,exit -F arch=b64 -S fsetxattr -F auid>=1000 -F auid!=-1 -k T1222_File_Directory_Permissions_Mod
-a always,exit -F arch=b64 -S lchown -F auid>=1000 -F auid!=-1 -k T1222_File_Directory_Permissions_Mod
-a always,exit -F arch=b64 -S lremovexattr -F auid>=1000 -F auid!=-1 -k T1222_File_Directory_Permissions_Mod
-a always,exit -F arch=b64 -S lsetxattr -F auid>=1000 -F auid!=-1 -k T1222_File_Directory_Permissions_Mod
-a always,exit -F arch=b64 -S removexattr -F auid>=1000 -F auid!=-1 -k T1222_File_Directory_Permissions_Mod
-a always,exit -F arch=b64 -S setxattr -F auid>=1000 -F auid!=-1 -k T1222_File_Directory_Permissions_Mod
## 32-bit DAC modifications
-a always,exit -F arch=b32 -S chmod -F auid>=500 -F auid!=4294967295 -k T1222_File_Directory_Permissions_Mod
-a always,exit -F arch=b32 -S chown -F auid>=500 -F auid!=4294967295 -k T1222_File_Directory_Permissions_Mod
-a always,exit -F arch=b32 -S fchmod -F auid>=500 -F auid!=4294967295 -k T1222_File_Directory_Permissions_Mod
-a always,exit -F arch=b32 -S fchmodat -F auid>=500 -F auid!=4294967295 -k T1222_File_Directory_Permissions_Mod
-a always,exit -F arch=b32 -S fchown -F auid>=500 -F auid!=4294967295 -k T1222_File_Directory_Permissions_Mod
-a always,exit -F arch=b32 -S fchownat -F auid>=500 -F auid!=4294967295 -k T1222_File_Directory_Permissions_Mod
-a always,exit -F arch=b32 -S fremovexattr -F auid>=500 -F auid!=4294967295 -k T1222_File_Directory_Permissions_Mod
-a always,exit -F arch=b32 -S fsetxattr -F auid>=500 -F auid!=4294967295 -k T1222_File_Directory_Permissions_Mod
-a always,exit -F arch=b32 -S lchown -F auid>=500 -F auid!=4294967295 -k T1222_File_Directory_Permissions_Mod
-a always,exit -F arch=b32 -S lremovexattr -F auid>=500 -F auid!=4294967295 -k T1222_File_Directory_Permissions_Mod
-a always,exit -F arch=b32 -S lsetxattr -F auid>=500 -F auid!=4294967295 -k T1222_File_Directory_Permissions_Mod
-a always,exit -F arch=b32 -S removexattr -F auid>=500 -F auid!=4294967295 -k T1222_File_Directory_Permissions_Mod
-a always,exit -F arch=b32 -S setxattr -F auid>=500 -F auid!=4294967295 -k T1222_File_Directory_Permissions_Mod

## SUID/SGID execution detection — T1548.001 Setuid and Setgid
-a always,exit -F arch=b64 -S setuid -S setgid -S setreuid -S setregid -k T1548.001_Setuid_Setgid
-a always,exit -F arch=b32 -S setuid -S setgid -S setreuid -S setregid -k T1548.001_Setuid_Setgid
-a always,exit -F arch=b64 -S setuid -S setgid -S setreuid -S setregid -F exit=EPERM -k T1548.001_Setuid_Setgid
-a always,exit -F arch=b32 -S setuid -S setgid -S setreuid -S setregid -F exit=EPERM -k T1548.001_Setuid_Setgid
### Detect execution where auid != uid (SUID binary execution)
-a always,exit -F arch=b64 -C auid!=uid -S execve -k T1548.001_Setuid_Setgid
-a always,exit -F arch=b32 -C auid!=uid -S execve -k T1548.001_Setuid_Setgid

